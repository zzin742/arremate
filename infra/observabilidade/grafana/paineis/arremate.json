{
  "uid": "arremate-rnf",
  "title": "Arremate — requisitos não funcionais",
  "description": "Cada painel aponta para o requisito que mede. O limiar desenhado é o número do requisito, não um valor escolhido para o gráfico ficar bonito.",
  "tags": ["arremate", "rnf"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RNF-001 — P95 do registro de lance (limite 300 ms)",
      "description": "O histograma tem fronteira em 0,3 s de propósito: sem ela o quantil perto do limite sairia de interpolação entre 0,25 e 0,5.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_requisicao_duracao_segundos_bucket{servico=\"lei\",rota=\"/leiloes/:id/lances\",metodo=\"POST\"}[5m])))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.3 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RNF-002 — P95 da busca no catálogo (limite 500 ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_requisicao_duracao_segundos_bucket{servico=\"cat\",rota=\"/equipamentos\",metodo=\"GET\"}[5m])))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RNF-007b — idade da pendência mais antiga da outbox (limite 5 min)",
      "description": "Mede o atraso entre o commit e a publicação. Contagem de pendentes não serviria: mil eventos de um segundo atrás estão saudáveis, um evento de dez minutos não.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (servico) (outbox_pendencia_mais_antiga_segundos)",
          "legendFormat": "{{servico}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 300 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RNF-006 — serviços no ar",
      "description": "`up` vem do Prometheus, não da aplicação: um serviço caído não exporta métrica nenhuma, e é exatamente aí que a medida precisa existir.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"arremate\"}",
          "legendFormat": "{{servico}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requisições por segundo, por serviço",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (servico) (rate(http_requisicao_duracao_segundos_count[5m]))",
          "legendFormat": "{{servico}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Erros 5xx por segundo",
      "description": "Só 5xx. O 409 de lance abaixo do atual é regra de negócio funcionando — o RNF-004 diz, com todas as letras, que rejeição por regra não conta como falha.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (servico) (rate(http_requisicao_duracao_segundos_count{status=~\"5..\"}[5m]))",
          "legendFormat": "{{servico}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Atraso do laço de eventos (P99)",
      "description": "Denuncia o serviço lento sem nenhuma rota lenta: trabalho síncrono segurando o Node. Sem isto, a investigação começaria pelo banco.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "{{servico}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    }
  ]
}
